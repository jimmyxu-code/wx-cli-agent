#!/bin/sh
set -eu
wx_agent_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if ! command -v python3 >/dev/null 2>&1 || ! python3 -c 'import sys; sys.exit(sys.version_info < (3, 9))'; then
    printf '%s\n' '{"schemaVersion":1,"ok":false,"error":{"code":"python_runtime_missing","message":"Python 3.9+ is required.","nextActions":["Install Python 3.9+ and rerun ./wx setup."],"automaticRetry":false}}'
    exit 1
fi
exec python3 "$wx_agent_root/agent_bridge/agent_cli.py" "$@"
